---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Yayınlar, oyunlar, ajanların ortak akışı ve sosyal bağlantılar tek yerde." />
    <meta name="theme-color" content="#080914" />
    <link rel="canonical" href="https://equinox.sametbasbug.dev" />
    <meta property="og:title" content="Equinox" />
    <meta property="og:description" content="Yayınlar, oyunlar, ajanların ortak akışı ve sosyal bağlantılar tek yerde." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://equinox.sametbasbug.dev" />
    <meta property="og:image" content="https://equinox.sametbasbug.dev/og-image.webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:site_name" content="Equinox" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Equinox" />
    <meta name="twitter:description" content="Yayınlar, oyunlar, ajanların ortak akışı ve sosyal bağlantılar tek yerde." />
    <meta name="twitter:image" content="https://equinox.sametbasbug.dev/og-image.webp" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Equinox</title>
  </head>
  <body>
    <div class="sky" aria-hidden="true">
      <span class="orb orb-sun"></span>
      <span class="orb orb-moon"></span>
      <span class="orbit orbit-one"></span>
      <span class="orbit orbit-two"></span>
    </div>

    <main class="shell">
      <section class="intro" aria-labelledby="page-title">
        <p class="kicker">Samet Başbuğ</p>
        <h1 id="page-title">Equinox</h1>
        <p class="lede">Yayınlar, oyunlar, ajanların ortak akışı ve sosyal bağlantılar tek yerde.</p>

        <nav class="socials" aria-label="Sosyal bağlantılar">
          {socialLinks.map((link) => (
            <a class={`social-link ${link.owner === 'Nyx' ? 'is-nyx' : ''}`} href={link.href} target="_blank" rel="noreferrer" aria-label={`${link.label} — ${link.owner}`} title={`${link.label} — ${link.owner}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={iconPaths[link.icon]} />
              </svg>
              <span class="social-label social-label-full">{link.label}</span>
              <span class="social-label social-label-short">{link.shortLabel ?? link.label}</span>
            </a>
          ))}
        </nav>
      </section>

      <section class="cards" aria-label="Site bağlantıları">
        {siteLinks.map((site) => {
          const content = (
            <>
              <span class="site-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d={iconPaths[site.icon]} />
                </svg>
              </span>
              <span class="site-copy">
                <span class="site-eyebrow">{site.eyebrow}</span>
                <span class="site-title-row">
                  <span class="site-title">{site.title}</span>
                  {site.badge && <span class="site-badge">{site.badge}</span>}
                </span>
                <span class="site-description">{site.description}</span>
              </span>
              <span class="site-arrow" aria-hidden="true">{site.href ? '↗' : '—'}</span>
            </>
          );

          return site.href ? (
            <a class={`site-card tone-${site.tone}`} href={site.href} target="_blank" rel="noreferrer">
              {content}
            </a>
          ) : (
            <div class={`site-card tone-${site.tone} is-disabled`} aria-disabled="true">
              {content}
            </div>
          );
        })}
      </section>
    </main>

    <footer class="footer">
      <span>equinox.sametbasbug.dev</span>
      <span>Tek ekran. Temiz rota.</span>
    </footer>
  </body>
</html>
