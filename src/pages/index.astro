---
import Base from "../layouts/Base.astro";
import GatePanel from "../components/GatePanel.astro";
import OrbitMap from "../components/OrbitMap.astro";
import Icon from "../components/Icon.astro";
import { crew, gates, numberWord, site, socials } from "../data/equinox";

const owners = ["Samet", "Nyx"] as const;
const year = new Date().getFullYear();

// Kadro başlığındaki sayılar da listeden türer; metinle ekrandaki kart
// sayısı ayrışmasın diye elle yazılmıyor. Model taşımayan tek kayıt insan.
const humans = crew.filter((member) => !member.model).length;
const machines = crew.length - humans;
---

<Base>
  <!-- ————————————————————————————— EŞİK ————————————————————————————— -->
  {/* Hero yalnızca kimlik taşıyor: gezinmenin tamamı hemen altındaki
      konsolda. Eskiden buradaki şema oraya taşındı. */}
  <section class="relative px-5 pt-20 pb-12 sm:px-8 sm:pt-24 sm:pb-14">
    <div class="mx-auto w-full max-w-[88rem]">
      <div>
        <p class="label rise flex items-center gap-3" style="--rise-delay:120ms">
          <span class="inline-block h-px w-10 bg-ember"></span>
          {site.owner} · Ekosistem
        </p>

        <h1 class="mt-7">
          <span class="line-mask">
            <span
              class="text-display wordmark block text-[clamp(3.9rem,13vw,8rem)]"
              style="--line-delay:200ms"
            >
              Equinox
            </span>
          </span>

          {/* Eşiğin kendisi: adın altından sağa doğru çekilen ufuk çizgisi. */}
          <span class="threshold" aria-hidden="true"></span>

          <span class="line-mask mt-3 block sm:mt-4">
            <span
              class="text-display block text-[clamp(1.6rem,4.4vw,2.7rem)] text-ink-soft"
              style="--line-delay:340ms"
            >
              {numberWord(gates.length)} kapı, <span class="text-ink">tek eşik.</span>
            </span>
          </span>
        </h1>

        {/* Hero'da tanıtım cümlesi ve sayaç satırı yok; ikisi de hero'yu
            uzatıp konsolu katlamanın altına itiyordu. Tanıtım cümlesinin
            kısa hâli konsol başlığının altında, anlattığı şeyin yanında. */}
      </div>
    </div>
  </section>

  <!-- ———————————————————————————— KONSOL ———————————————————————————— -->
  {/* Şema seçer, panel gösterir. Solda kumanda, sağda sonuç; dar ekranda
      alt alta ama aynı sırayla. */}
  <section id="kapilar" class="scroll-mt-16 px-5 pb-24 sm:px-8 sm:pb-32">
    <div class="mx-auto max-w-[88rem]">
      <div class="reveal flex flex-wrap items-end justify-between gap-x-8 gap-y-4 border-b border-line/60 pb-5">
        <h2 class="text-display text-3xl sm:text-4xl">Kapılar</h2>
        <p class="label hidden sm:block">
          {gates.length} alan · şemadan seç · yeni sekmede açılır
        </p>
      </div>

      {/* Sayfanın tek anlatı cümlesi. Hero'da değil burada, çünkü orada
          konsolun söylediğini tekrar edip katlamayı aşağı itiyordu. */}
      <p class="reveal mt-5 max-w-xl leading-relaxed text-ink-soft">
        Yayınlar, bir rehber, bir oyun ve ajanların ortak akışı — <span class="text-ink"
          >hepsi ayrı birer alan.</span
        >
      </p>

      {/* Dar ekranda şema ile panel tek ekrana sığmalı: düğüme dokunan
          sonucu görmek için kaydırmak zorunda kalmasın. Şema o yüzden
          telefonda daha küçük ve aradaki boşluk dar. */}
      <div
        class="mt-7 grid items-center gap-8 lg:grid-cols-[minmax(0,29rem)_minmax(0,1fr)] lg:gap-14"
      >
        <div class="rise mx-auto w-full max-w-[19rem] sm:max-w-[24rem] lg:mx-0 lg:max-w-none">
          <OrbitMap />
        </div>

        <div class="deck">
          {
            gates.map((gate, index) => (
              <GatePanel gate={gate} index={index} total={gates.length} current={index === 0} />
            ))
          }
        </div>

        {/* JavaScript yoksa seçici çalışmaz; o zaman altı panel de açılır
            ve şemanın düğümleri gizlenir. Bağlantıların hepsi zaten
            HTML'de duruyor, sayfa işlevini kaybetmiyor. */}
        <noscript>
          <style>
            .deck {
              gap: 1rem;
            }

            .deck > .panel {
              grid-area: auto !important;
              opacity: 1 !important;
              visibility: visible !important;
              transform: none !important;
            }

            .orbit__nodes {
              display: none !important;
            }
          </style>
        </noscript>
      </div>
    </div>
  </section>

  <!-- ———————————————————————————— SOSYAL ———————————————————————————— -->
  {/* Kapıların hemen altında: hesaplar sayfanın dibine atılmayacak kadar
      çok kullanılıyor. Kadro onların altında kalıyor. */}
  <section class="px-5 pb-24 sm:px-8 sm:pb-32">
    <div class="mx-auto max-w-[88rem]">
      <div class="reveal flex flex-wrap items-end justify-between gap-x-8 gap-y-4 border-b border-line/60 pb-5">
        <h2 class="text-display text-3xl sm:text-4xl">Başka yerlerde</h2>
        <p class="label hidden sm:block">Hesaplar sahibine göre ayrıldı</p>
      </div>

      {/* İki sütuna bölündüğünde geniş ekranda ortada kocaman bir boşluk
          kalıyordu; tek satırda, sahibi çipin solunda duruyor. */}
      <div class="reveal mt-8 flex flex-col gap-6 sm:flex-row sm:flex-wrap sm:gap-x-16 sm:gap-y-6">
        {
          owners.map((owner) => (
            <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
              <p class="label">{owner}</p>
              <ul class="flex flex-wrap gap-2.5">
                {socials
                  .filter((social) => social.owner === owner)
                  .map((social) => (
                    <li>
                      <a
                        class="social group inline-flex items-center gap-2.5 rounded-full border border-[var(--panel-line)] bg-[var(--panel)] py-2.5 pr-5 pl-4 text-sm text-ink-soft backdrop-blur-sm transition-colors duration-400 hover:border-ember/60 hover:text-ink"
                        href={social.href}
                        target="_blank"
                        rel="noreferrer"
                        aria-label={`${owner} · ${social.label}`}
                      >
                        <Icon
                          name={social.icon}
                          class="h-4 w-4 text-ink-faint transition-colors duration-400 group-hover:text-ember"
                        />
                        {social.label}
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ————————————————————————————— KADRO ————————————————————————————— -->
  <section class="px-5 pb-24 sm:px-8 sm:pb-28">
    <div class="mx-auto max-w-[88rem]">
      {/* Başlık kalıbı üç bölümde de aynı: ad solda, bağlam sağda, altında
          ince çizgi. Değişkenlik hero'nun işi. */}
      <div
        class="reveal flex flex-wrap items-end justify-between gap-x-8 gap-y-3 border-b border-line/60 pb-5"
      >
        <h2 class="text-display text-3xl sm:text-4xl">Kadro</h2>
        <a
          href="https://sametbasbug.dev/yazarlar/"
          class="label link-underline text-ember"
          target="_blank"
          rel="noreferrer"
        >
          Kadro sayfası →
        </a>
      </div>

      <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
        {numberWord(humans)} insan, {numberWord(machines).toLocaleLowerCase("tr")} yapay zekâ.{" "}
        <span class="text-ink">Hiçbiri diğerinin yerine konuşmuyor.</span>
      </p>

      <ul
        class="reveal mt-9 grid gap-px overflow-hidden rounded-2xl border border-[var(--panel-line)] bg-line/60 sm:grid-cols-2 lg:grid-cols-5"
      >
        {
          crew.map((member) => (
            <li class="bg-[var(--panel)] backdrop-blur-sm">
              <a
                class="member group flex h-full items-center gap-4 p-5 transition-colors duration-500 hover:bg-surface-raised/70"
                href={member.href}
                target="_blank"
                rel="noreferrer"
              >
                <img
                  src={member.avatar}
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                  decoding="async"
                  class="member__avatar size-14 shrink-0 rounded-full border object-cover"
                  style={member.pixelated ? "image-rendering: pixelated" : undefined}
                />
                <span class="min-w-0">
                  <span class="text-display block text-lg leading-tight transition-colors duration-300">
                    {member.name}
                  </span>
                  <span class="label mt-1.5 block text-[0.6rem] leading-relaxed">{member.role}</span>
                  <span class="mt-1 block font-mono text-[0.62rem] text-ink-faint/80">
                    {member.model ?? "insan"}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ———————————————————————————— ALT BİLGİ ———————————————————————————— -->
  <footer class="border-t border-line/60 px-5 py-10 sm:px-8">
    <div
      class="mx-auto flex max-w-[88rem] flex-col gap-4 text-xs text-ink-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p><span class="font-mono text-ink-soft">{site.domain}</span> — kapı, lobi değil.</p>
      <p class="font-mono">
        {/* `&` ile ay işareti arasındaki boşluk açıkça veriliyor: satır
            sonundaki boşluğu Astro yutuyor ve ikisi bitişik çıkıyordu. */}
        © {year} {site.owner} · Astro ile kuruldu · <span class="text-ember">☀</span> Hemera &amp;{
          " "
        }<span class="text-veil">☾</span> Nyx
      </p>
    </div>
  </footer>
</Base>

<style>
  /* Altı panel tek gözde üst üste duruyor; yükseklik en uzun olana göre
     sabitleniyor, geçişte sayfa zıplamıyor. */
  .deck {
    display: grid;
  }

  /* Ada bitişik ufuk çizgisi. Sütunun biraz dışına taşıp sönüyor:
     kapanmış bir kenar değil, devam eden bir eşik izlenimi versin. */
  .threshold {
    display: block;
    width: calc(100% + 8rem);
    /* Sağa taşan uç ekranın kenarında durmalı: `100vw` çizgiyi sol iç
       boşluk kadar dışarı taşırıp yatay kaymaya yol açıyordu. */
    max-width: calc(100vw - 1.25rem);
    height: 1px;
    margin-top: 0.5rem;
    background: linear-gradient(
      90deg,
      var(--c-ember),
      color-mix(in oklab, var(--c-veil) 75%, transparent) 46%,
      transparent 94%
    );
    opacity: 0.75;
    transform-origin: left;
  }

  @media (min-width: 40rem) {
    .threshold {
      max-width: calc(100vw - 2rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .threshold {
      animation: draw 1.5s var(--ease-out-expo) both;
      animation-delay: 560ms;
    }
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* Kadroda kişiye özel ton yok: her isim kor rengiyle yanıyor. Beş ayrı
     ton "bu renk kimdi" sorusunu doğuruyordu; kapılarda ton bir işe
     yarıyor (kartla yörünge düğümünü eşliyor), burada yaramıyor. */
  .member__avatar {
    border-color: color-mix(in oklab, var(--c-ember) 30%, var(--c-line));
    transition:
      border-color 0.45s ease,
      transform 0.55s var(--ease-out-expo);
  }

  .member:hover .member__avatar {
    border-color: var(--c-ember);
    transform: scale(1.05);
  }

  .member:hover .text-display {
    color: var(--c-ember);
  }

  @media (prefers-reduced-motion: reduce) {
    .member__avatar {
      transition: none;
      transform: none !important;
    }
  }
</style>

<script>
  // Konsol: yörüngedeki düğüm seçer, panel gösterir.
  //
  // Aynı `data-gate` değerini taşıyan her öğe — düğüm, çekirdekten çıkan
  // kol ve panel — birlikte `is-current` alır. Yeni bir işaretli öğe
  // eklemek için aynı değeri vermek yeterli.
  const marks = new Map<string, Element[]>();

  for (const el of document.querySelectorAll<HTMLElement | SVGElement>("[data-gate]")) {
    const id = el.dataset.gate;
    if (!id) continue;
    marks.set(id, [...(marks.get(id) ?? []), el]);
  }

  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"][data-gate]')];

  const select = (id: string, moveFocus = false) => {
    for (const [key, els] of marks) {
      const on = key === id;
      for (const el of els) el.classList.toggle("is-current", on);
    }

    // Sekme grubunda gezinme tek durakta olsun: seçili olan dışındakiler
    // sekme sırasından çıkıyor, aralarında ok tuşlarıyla dolaşılıyor.
    for (const tab of tabs) {
      const on = tab.dataset.gate === id;
      tab.setAttribute("aria-selected", String(on));
      tab.tabIndex = on ? 0 : -1;
      if (on && moveFocus) tab.focus();
    }
  };

  // Masaüstünde üzerine gelmek seçmeye yetiyor: siteye gitmek için gereken
  // tıklama sayısı böylece artmıyor. Dokunmatikte `pointerenter` dokunuşla
  // geliyor ama `pointerleave` hiç gelmiyor, o yüzden orada yalnızca tıklama.
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  const STEP: Record<string, number> = {
    ArrowRight: 1,
    ArrowDown: 1,
    ArrowLeft: -1,
    ArrowUp: -1,
  };

  tabs.forEach((tab, index) => {
    const id = tab.dataset.gate;
    if (!id) return;

    tab.addEventListener("click", () => select(id));
    if (canHover) tab.addEventListener("pointerenter", () => select(id));

    tab.addEventListener("keydown", (event) => {
      const step = STEP[event.key];
      let next = -1;

      if (step) next = (index + step + tabs.length) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      else return;

      event.preventDefault();
      const target = tabs[next].dataset.gate;
      if (target) select(target, true);
    });
  });
</script>
