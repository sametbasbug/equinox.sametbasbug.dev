---
import '../styles/global.css';
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Bu Equinox rotası bulunamadı." />
    <meta name="theme-color" content="#080914" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>404 · Equinox</title>
  </head>
  <body>
    <div class="sky" aria-hidden="true">
      <span class="orb orb-sun"></span>
      <span class="orb orb-moon"></span>
      <span class="orbit orbit-one"></span>
      <span class="orbit orbit-two"></span>
    </div>

    <main class="not-found-shell" aria-labelledby="not-found-title">
      <p class="kicker">404</p>
      <h1 id="not-found-title">Bu rota kaybolmuş.</h1>
      <p class="lede">Aradığın bağlantı taşınmış ya da hiç açılmamış olabilir. Equinox ana kapısı hâlâ burada.</p>
      <a class="home-link" href="/">Ana sayfaya dön</a>
    </main>
  </body>
</html>
